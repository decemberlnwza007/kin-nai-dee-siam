# URL ของ backend โดยไม่ต้องใส่ / ท้ายสุด
BACKEND_URL=http://localhost:8080
ML_SERVICE_URL=http://localhost:8000

# LINE Login channel (สร้างจาก LINE Developers Console)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CALLBACK_URL=http://localhost:3000/api/auth/line/callback
# สุ่มค่าอย่างน้อย 32 ตัวอักษร และห้าม commit ค่าจริง
LINE_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Long-lived Channel Access Token จาก Messaging API channel ใน Provider เดียวกัน
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
